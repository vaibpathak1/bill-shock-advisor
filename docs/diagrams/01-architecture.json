  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Question → REST API → ChatOrchestrator",
        "Tools call Java engines; the LLM never does arithmetic",
        "Answer streams back as gated SSE sentences"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "Identity comes from the SecurityContext, never tool arguments",
        "Only scrubbed text and masked MSISDNs reach Claude",
        "Failed gate or no LLM → template answer"
      ]
    },
    {
      "dot": "amber",
      "title": "Planned, not built",
      "items": [
        "Redis cache and rate limits (Phase 7)",
        "Kafka topics and proactive-worker (Phase 7)",
        "Today: one process, mock BSS in-process"
      ]
    }
