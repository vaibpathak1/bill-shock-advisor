# Copy to .env and fill in real values. Never commit .env.
# Anthropic key of the live-chat workspace (llm-architecture.md §1). Never commit a real key.
ANTHROPIC_API_KEY_CHAT=your-chat-workspace-api-key
# LLM (default) or TEMPLATE_ONLY: deterministic answers only, no key needed (ADR-005 kill switch).
BILLSHOCK_LLM_MODE=LLM
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (docker compose and the dev profile)
POSTGRES_DB=billshock
POSTGRES_USER=billshock
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# In-memory demo customers cust1001..cust1006 (dev profile only; A-97)
DEMO_USER_PASSWORD=choose-a-demo-password
